<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}COMAK Simulation Results{% endblock %}</title>
<style>
  body { font-family: Arial, sans-serif; margin: 0; background-color: #e0e0e0; }
  nav { background-color: #333; position: fixed; top: 0; width: 100%; z-index: 100; display: flex; align-items: center; flex-wrap: wrap; }
  nav a { color: white; text-decoration: none; display: inline-block; padding: 10px 14px; font-size: 0.9em; }
  nav a:hover { background-color: #ddd; color: black; }
  nav a.highlight { background-color: #fff; color: #8B0000; font-weight: bold; }
  nav select { margin: 6px 10px; padding: 4px 8px; border-radius: 4px; }
  section { padding: 20px 40px; margin: 30px 20px; border-radius: 8px; background-color: white; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  h1, h2, h3, h4 { color: #333; }
  .page-header { text-align: center; padding: 80px 20px 24px; background-color: #8B0000; color: white; border-bottom: 2px solid #ccc; }
  .page-header h1 { margin: 0; font-size: 2.2em; }
  .page-header p  { margin: 8px 0 0; font-size: 1.1em; opacity: .85; }
  .img-full { max-width: 100%; height: auto; display: block; margin: 16px auto; border: 1px solid #ddd; border-radius: 4px; }
  .img-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 12px; }
  .img-grid img { width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; }
  .select-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .select-row select { padding: 5px 10px; border-radius: 4px; }
  caption { font-size: 0.85em; color: #666; text-align: center; margin-top: 4px; display: block; }
  pre { background: #f5f5f5; padding: 12px; border-radius: 4px; overflow-x: auto; font-size: 0.9em; }
  code { background: #f0f0f0; padding: 2px 5px; border-radius: 3px; font-family: monospace; }
  ul, ol { line-height: 1.7; }
</style>
<script>
function goToPatient() {
  var v = document.getElementById("patientSelect").value;
  if (v) window.location.href = v;
}
function updateImg(selectId, imgId) {
  var s = document.getElementById(selectId);
  var img = document.getElementById(imgId);
  img.src = s.dataset.base + s.value + ".png";
}
function resetGIFs() {
  var ts = Date.now();
  document.querySelectorAll(".sync-gif").forEach(function(g) {
    g.src = g.src.split("?")[0] + "?" + ts;
  });
}
window.onload = function() { resetGIFs(); setInterval(resetGIFs, 4000); };
</script>
</head>
<body>

<nav>
  {% block nav %}{% endblock %}
  <select id="patientSelect" onchange="goToPatient()">
    <option value="">— Select Patient —</option>
    {% for p in patient_links %}
    <option value="{{ p.href }}">{{ p.label }}</option>
    {% endfor %}
  </select>
</nav>

{% block header %}{% endblock %}

{% block content %}{% endblock %}

</body>
</html>
